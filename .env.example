# ==========================================
# KASIMEDU DIRECT - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN="your_meta_system_user_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_business_phone_number_id"

# 2. Owner & Admin Alerts WhatsApp Mobile Number (Include country code e.g. 91...)
OWNER_WHATSAPP_NUMBER="919840110022"

# 3. Razorpay Payment Gateway Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# 4. Optional: Supabase / PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
